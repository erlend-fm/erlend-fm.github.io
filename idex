    function setLanguage(lang) {
      const dict = translations[lang];
      if (!dict) return;
      document.documentElement.lang = lang === 'no' ? 'nb' : 'en';
      document.title = dict['pageTitle'];
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        const key = el.getAttribute('data-i18n');
        if (dict[key]) el.textContent = dict[key];
      });
      // Update active button
      document.querySelectorAll('.lang-btn').forEach(function(btn) {
        btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
      });
      // Update projects toggle text based on current state
      const toggle = document.getElementById('projectsToggle');
      const textEl = toggle.querySelector('.toggle-text');
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      textEl.textContent = isOpen ? dict['projects.hide'] : dict['projects.show'];
      // Remember choice
      try { localStorage.setItem('cv-lang', lang); } catch (e) {}
    }

    (function() {
      // Language switcher buttons
      document.querySelectorAll('.lang-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          setLanguage(btn.getAttribute('data-lang'));
        });
      });

      // Load saved language preference
      let savedLang = 'no';
      try { savedLang = localStorage.getItem('cv-lang') || 'no'; } catch (e) {}
      if (savedLang === 'en') setLanguage('en');

      // Project toggle
      const toggle = document.getElementById('projectsToggle');
      const content = document.getElementById('projectsContent');
      const textEl = toggle.querySelector('.toggle-text');
      toggle.addEventListener('click', function() {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', !expanded);
        content.classList.toggle('open');
        const currentLang = document.querySelector('.lang-btn.active').getAttribute('data-lang');
        const dict = translations[currentLang];
        textEl.textContent = expanded ? dict['projects.show'] : dict['projects.hide'];
      });

      // Auto-expand projects when printing
      window.addEventListener('beforeprint', function() {
        content.classList.add('open');
      });
    })();
